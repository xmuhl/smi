+        "Install web dependencies",
+        "Type check",
+        "Build",
+        "Deploy to Cloudflare Pages",
+    ):
+        marker = f"- name: {step_name}"
+        start = workflow.index(marker)
+        next_step = workflow.find("\n      - name:", start + len(marker))
+
+        block = (
+            workflow[start:]
+            if next_step < 0
+            else workflow[start:next_step]
+        )
+
